#!/usr/bin/env python3
#
# console-reblank: turn the monitors off again after a hotplug wakes them while the text console is
# blanked (see /etc/udev/rules.d/90-console-reblank.rules). Under niri the console counts as blanked
# too, but niri owns the display then and the kernel ignores the write.

import fcntl
import os
import time

TIOCLINUX = 0x541C
TIOCL_BLANKEDSCREEN = 15

# The kernel lights the console again right after it sends the hotplug event; let that finish first.
time.sleep(1)
fd = os.open("/dev/tty0", os.O_RDONLY)
if fcntl.ioctl(fd, TIOCLINUX, bytearray([TIOCL_BLANKEDSCREEN]), True):
    with open("/sys/class/graphics/fb0/blank", "w") as f:
        f.write("1")
