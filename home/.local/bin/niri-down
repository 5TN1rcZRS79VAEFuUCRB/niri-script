#!/usr/bin/env python3
"""
niri-down: Mod+S / Mod+J (and Mod+wheel down). Runs a niri focus-down action, but not from an empty
workspace into another empty one. niri always keeps a spare empty workspace at the bottom: with
windows open you can go down to it to start a new workspace, but with nothing open there is nowhere
to go, which matches the bar (~/.config/waybar/style.css).

  niri-down [action]    default focus-window-or-workspace-down
"""
import json
import subprocess
import sys


def niri(*args):
    return json.loads(subprocess.run(["niri", "msg", "-j", *args], capture_output=True, check=True).stdout)


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "focus-window-or-workspace-down"
    workspaces = niri("workspaces")
    ws = next(w for w in workspaces if w["is_focused"])
    below = next((w for w in workspaces if w["output"] == ws["output"] and w["idx"] == ws["idx"] + 1), None)
    if ws["active_window_id"] is not None or (below and below["active_window_id"] is not None):
        subprocess.run(["niri", "msg", "action", action])


if __name__ == "__main__":
    main()
