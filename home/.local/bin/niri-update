#!/usr/bin/env bash
#
# niri-update: pulls this repo and re-runs install.sh when a new commit is pushed, then asks for niri to
# restart. Run every 5 minutes by niri-update.timer. install.sh records the commit it installed, so a
# failed install (pacman lock, no network) is retried on the next run instead of being skipped.
# The restart waits until you are idle: swayidle does it (see ~/.config/niri/config.kdl).

set -euo pipefail
trap 'notify-send -u critical "niri-update failed" "journalctl --user -u niri-update" 2>/dev/null || true' ERR

cd "$HOME/.local/share/arch-dwm-desktop"   # symlink to the clone, made by install.sh
git pull --ff-only -q                       # refuses (and notifies) if this clone has diverged
[ "$(git rev-parse HEAD)" = "$(cat "$HOME/.local/state/arch-dwm-desktop-installed" 2>/dev/null)" ] && exit 0

./install.sh
# dwm-restart-session: login shells started before the dwm- to niri- rename still wait for that name.
# ponytail: drop it once every machine has logged in again since the rename.
touch "$XDG_RUNTIME_DIR/niri-restart-session" "$XDG_RUNTIME_DIR/dwm-restart-session"
