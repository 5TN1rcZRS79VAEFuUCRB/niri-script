#!/bin/sh
# dmenu for Wayland: bemenu takes dmenu's options (-i, -l, -p), so the pickers in ~/.local/bin keep
# calling "dmenu". Adds dmenu's colors from the old config.h and the bar's block border. The bar
# reserves no space (~/.config/waybar/config.jsonc), so the menu opens at the top of the screen,
# over the bar; -H 27 makes it tall enough to cover the bar's blocks.
#
#   dmenu [dmenu options]    a menu of the lines on stdin
#   dmenu run                the app launcher (Mod+P)
menu=bemenu
[ "$1" = run ] && { menu=bemenu-run; set -- -p run:; }
exec "$menu" -fn "monospace 10" -H 27 -B 1 --hp 10 --bdr '#444444' \
	--tb '#eeeeee' --tf '#000000' --fb '#222222' --ff '#bbbbbb' --cb '#bbbbbb' --cf '#222222' \
	--nb '#222222' --nf '#bbbbbb' --ab '#222222' --af '#bbbbbb' \
	--hb '#eeeeee' --hf '#000000' --sb '#eeeeee' --sf '#000000' \
	--scb '#222222' --scf '#444444' "$@"
