#!/bin/sh
# dmenu for Wayland: bemenu takes dmenu's options (-i, -l, -p), so the pickers in ~/.local/bin keep
# calling "dmenu". Adds dmenu's colors from the old config.h and the bar's block border. The bar
# reserves no space (~/.config/waybar/config.jsonc), so the menu opens at the top of the screen,
# over the bar: a one-line menu is -H 27 tall to cover the bar's blocks; a list covers them with
# two rows, so its rows are tighter.
#
#   dmenu [dmenu options]    a menu of the lines on stdin
#   dmenu run                the app launcher (Mod+P)
menu=bemenu
[ "$1" = run ] && { menu=bemenu-run; set -- -p " run"; }  # Nerd Font terminal icon

lines=0 prev=  # the -l value: a list rather than one line
for a; do [ "$prev" = -l ] && lines=$a; prev=$a; done

set -- -fn "monospace 10" -B 1 --hp 10 --bdr '#444444' \
	--tb '#eeeeee' --tf '#000000' --fb '#222222' --ff '#bbbbbb' --cb '#bbbbbb' --cf '#222222' \
	--nb '#222222' --nf '#bbbbbb' --ab '#222222' --af '#bbbbbb' \
	--hb '#eeeeee' --hf '#000000' --sb '#eeeeee' --sf '#000000' \
	--scb '#222222' --scf '#444444' "$@"

[ "$lines" -gt 0 ] 2>/dev/null || exec "$menu" -H 27 "$@"

# A list keeps its height while you type (--fixed-height), so it never shrinks off the bar, and is
# only as long as its lines (a later -l wins), so it has no empty rows. -s starts the rows at the
# left edge instead of after the prompt.
input=$(cat)
n=$(printf '%s\n' "$input" | wc -l)
[ "$n" -lt "$lines" ] && set -- "$@" -l "$n"
printf '%s\n' "$input" | "$menu" -H 22 -s --fixed-height "$@"
