#!/usr/bin/env bash
#
# niri-lid: closing the laptop lid turns the screen off at once and suspends after 5 minutes still
# closed; opening it before then cancels that. logind has no delay for the lid, so it ignores the lid
# (/etc/systemd/logind.conf.d/50-niri-lid.conf) and niri runs this on lid events (config.kdl).
# Docked (an external monitor connected) it stays awake and the screens stay on, like logind's default.
#
#   niri-lid close|open
#   niri-lid sleep      what the 5-minute timer runs

docked() {
	busctl get-property org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager Docked | grep -q true
}

case "${1:-}" in
close)
	docked || niri msg action power-off-monitors
	# An elapsed timer stays loaded under its name, so clear it before starting a new one.
	systemctl --user stop niri-lid-sleep.timer 2>/dev/null
	systemd-run --user -q --collect --unit=niri-lid-sleep --on-active=5min --timer-property=AccuracySec=1s "$HOME/.local/bin/niri-lid" sleep ;;
open)
	systemctl --user stop niri-lid-sleep.timer 2>/dev/null
	niri msg action power-on-monitors ;;
sleep)
	docked || systemctl suspend ;;
*)
	echo "usage: niri-lid close|open|sleep" >&2; exit 2 ;;
esac
