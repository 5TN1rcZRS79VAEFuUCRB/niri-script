#!/usr/bin/env bash
#
# niri-audio: volume control and output/input device switching for the
# bar and keybindings (PipeWire via wpctl/pactl).
#
#   niri-audio vol up|down|mute|micmute|micup|micdown
#   niri-audio status              one-line summary for the bar: volume and mic icons with levels (Nerd Font)
#   niri-audio menu out|in         dmenu picker; sets the default device and
#                                 moves any playing/recording streams onto it

STEP=5

refresh_bar() {
	local pid
	pid="$(cat "${XDG_RUNTIME_DIR:-/tmp}/niri-status.pid" 2>/dev/null)" || return 0
	# Only signal the bar script itself: a stale pid file could name an unrelated process now (USR1 kills by default).
	[ -n "$pid" ] && grep -qa niri-status "/proc/$pid/cmdline" 2>/dev/null && kill -USR1 "$pid" 2>/dev/null
	return 0
}

DMENU=(dmenu -i -l 8)

kind_setup() {
	case "$1" in
	out) KIND=sinks; DEFAULT_CMD=get-default-sink; SET_CMD=set-default-sink
	     STREAMS=sink-inputs; MOVE_CMD=move-sink-input; PROMPT="Output" ;;
	in)  KIND=sources; DEFAULT_CMD=get-default-source; SET_CMD=set-default-source
	     STREAMS=source-outputs; MOVE_CMD=move-source-output; PROMPT="Input" ;;
	*)   echo "usage: niri-audio menu out|in" >&2; exit 2 ;;
	esac
}

# Prints "name<TAB>description" per real device (monitor sources excluded).
devices() {
	pactl --format=json list "$KIND" | python3 -c '
import json, sys
for d in json.load(sys.stdin):
    if d["name"].endswith(".monitor"):
        continue
    # Skip devices whose active jack is unplugged; WirePlumber will not route to them.
    avail = {q["name"]: q.get("availability") for q in d.get("ports", [])}.get(d.get("active_port"))
    if avail == "not available":
        continue
    print(d["name"] + "\t" + d["description"])'
}

list_entries() {
	local current name desc
	current="$(pactl "$DEFAULT_CMD")"
	while IFS=$'\t' read -r name desc; do
		if [ "$name" = "$current" ]; then echo "* $desc"; else echo "  $desc"; fi
	done < <(devices)
}

pick() {
	local label="${1#[* ] }" name desc target=""
	while IFS=$'\t' read -r name desc; do
		[ "$desc" = "$label" ] && { target="$name"; break; }
	done < <(devices)
	[ -n "$target" ] || exit 1
	pactl "$SET_CMD" "$target"
	# Move live streams too, otherwise already-playing apps stay on the old device.
	for id in $(pactl list short "$STREAMS" | cut -f1); do
		pactl "$MOVE_CMD" "$id" "$target" 2>/dev/null
	done
}

# Muting a filter-chain source (e.g. mic_filtered) is a software mute only: the
# micmute LED follows the ALSA capture switch of the real mic, which never sees it.
# Mirror the default source's mute onto the source the filter captures from.
sync_mic_mute() {
	local up m
	up="$(pw-dump | python3 -c '
import json, sys
nodes = [o["info"]["props"] for o in json.load(sys.stdin) if o["type"] == "PipeWire:Interface:Node"]
group = next((p.get("node.link-group") for p in nodes if p.get("node.name") == sys.argv[1]), None)
for p in nodes:
    if group and p.get("node.link-group") == group and p.get("media.class") == "Stream/Input/Audio" and p.get("target.object"):
        print(p["target.object"])
        break' "$(pactl get-default-source)")"
	[ -n "$up" ] || return 0
	if [[ "$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@)" == *MUTED* ]]; then m=1; else m=0; fi
	pactl set-source-mute "$up" "$m"
}

# "LABEL 40%" or "LABEL MUTE" for one wpctl node
level() {
	local v
	v="$(wpctl get-volume "$2" 2>/dev/null)"
	if [[ "$v" == *MUTED* ]]; then echo "${3:-$1} MUTE"; else awk -v l="$1" '{printf "%s %d%%\n", l, $2 * 100 + 0.5}' <<< "$v"; fi
}

case "$1" in
vol)
	case "$2" in
	up)      wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
	         wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "${STEP}%+" ;;
	down)    wpctl set-volume @DEFAULT_AUDIO_SINK@ "${STEP}%-" ;;
	mute)    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
	micmute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
	         sync_mic_mute ;;
	micup)   wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0
	         sync_mic_mute
	         wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ "${STEP}%+" ;;
	micdown) wpctl set-volume @DEFAULT_AUDIO_SOURCE@ "${STEP}%-" ;;
	*)       echo "usage: niri-audio vol up|down|mute|micmute|micup|micdown" >&2; exit 2 ;;
	esac
	refresh_bar ;;
status) echo "$(level  @DEFAULT_AUDIO_SINK@ ) $(level  @DEFAULT_AUDIO_SOURCE@ )" ;;
menu)
	kind_setup "$2"
	if [ "$2" = out ]; then other=in; link="-> Input devices"; else other=out; link="-> Output devices"; fi
	choice="$({ list_entries; echo "$link"; } | "${DMENU[@]}" -p "$PROMPT")" || exit 0
	case "$choice" in
	"")      ;;
	"$link") exec "$0" menu "$other" ;;
	*)       pick "$choice"; refresh_bar ;;
	esac ;;
*)
	echo "usage: niri-audio vol|status|menu" >&2; exit 2 ;;
esac
