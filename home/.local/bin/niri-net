#!/usr/bin/env python3
"""
niri-net: choose which network to use, from dmenu (needs NetworkManager).

  niri-net    pick a Wi-Fi network, a wired connection or an action

Choosing a Wi-Fi network connects to it. A network you have not used before that needs a
password opens a small terminal running `nmcli --ask`, so the password is never shown on
screen. Bound to Mod+N in ~/.config/niri/config.kdl.
"""
import shutil
import subprocess
import time

DMENU = ["dmenu", "-i", "-l", "14"]

BARS = ["____", "▂___", "▂▄__", "▂▄▆_", "▂▄▆█"]


def nmcli(*args, timeout=30):
    """Run nmcli; returns (ok, stdout, stderr)."""
    try:
        p = subprocess.run(["nmcli", *args], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, "", str(e)
    return p.returncode == 0, p.stdout, p.stderr.strip()


def split_terse(line):
    """Split one line of `nmcli -t` output on unescaped colons."""
    out, cur, i = [], [], 0
    while i < len(line):
        c = line[i]
        if c == "\\" and i + 1 < len(line):
            cur.append(line[i + 1])
            i += 2
        elif c == ":":
            out.append("".join(cur))
            cur = []
            i += 1
        else:
            cur.append(c)
            i += 1
    out.append("".join(cur))
    return out


def clean(text):
    """Network names come from other people's routers: force plain one-line text."""
    return " ".join(str(text).split())


def bars(signal):
    return BARS[sum(signal >= t for t in (20, 40, 60, 80))]


def wifi_radio_on():
    ok, out, _ = nmcli("radio", "wifi")
    return ok and out.strip() == "enabled"


def has_wifi_device():
    ok, out, _ = nmcli("-t", "-f", "TYPE", "device")
    return ok and "wifi" in out.split()


def saved_profiles():
    """{name: uuid} of saved Wi-Fi profiles."""
    ok, out, _ = nmcli("-t", "-f", "NAME,UUID,TYPE", "connection", "show")
    found = {}
    if ok:
        for line in out.splitlines():
            f = split_terse(line)
            if len(f) >= 3 and f[2] == "802-11-wireless":
                found[f[0]] = f[1]
    return found


def wired_and_other():
    """[(name, uuid, type, active)] for saved non-Wi-Fi profiles (ethernet, VPN, ...)."""
    ok, out, _ = nmcli("-t", "-f", "NAME,UUID,TYPE,DEVICE", "connection", "show")
    items = []
    if ok:
        for line in out.splitlines():
            f = split_terse(line)
            if len(f) < 4 or f[2] not in ("802-3-ethernet", "vpn", "wireguard", "gsm", "cdma", "pppoe"):
                continue
            items.append((f[0], f[1], f[2], bool(f[3])))
    return items


def scan():
    """[(in_use, ssid, signal, security)] strongest first, one row per network name."""
    ok, out, _ = nmcli("-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "device", "wifi", "list", "--rescan", "no")
    best = {}
    if ok:
        for line in out.splitlines():
            f = split_terse(line)
            if len(f) < 4 or not f[1].strip():
                continue                        # hidden network: use "Other network..." instead
            in_use, ssid, signal, sec = f[0] == "*", clean(f[1]), int(f[2] or 0), f[3]
            cur = best.get(ssid)
            if cur is None or in_use or (not cur[0] and signal > cur[2]):
                best[ssid] = (in_use, ssid, signal, sec)
    return sorted(best.values(), key=lambda r: (not r[0], -r[2], r[1].lower()))


def status_line():
    ok, out, _ = nmcli("-t", "-f", "TYPE,STATE,CONNECTION", "device")
    parts = []
    if ok:
        for line in out.splitlines():
            t, state, conn = (split_terse(line) + ["", "", ""])[:3]
            if state == "connected" and t in ("wifi", "ethernet"):
                parts.append(("Wi-Fi " if t == "wifi" else "Wired ") + clean(conn))
    return "Connected: " + ", ".join(parts) if parts else "Not connected"


def build_menu():
    """[(label, action)] where action is a tuple, or None for a line that only shows text."""
    rows = [(status_line(), None)]
    wifi = has_wifi_device()
    radio = wifi and wifi_radio_on()
    saved = saved_profiles() if wifi else {}
    if radio:
        nets = scan()
        if not nets:
            rows.append(("(no Wi-Fi networks found yet - try Rescan)", None))
        for in_use, ssid, signal, sec in nets:
            lock = "open" if not sec else sec.split()[0]
            tag = "connected" if in_use else ("saved" if ssid in saved else "")
            label = "%s %-32s %s %3d%%  %-5s %s" % ("*" if in_use else " ", ssid[:32], bars(signal), signal, lock, tag)
            rows.append((label.rstrip(), ("connect", ssid, bool(sec), saved.get(ssid), in_use)))
        rows.append(("Other network (hidden name)...", ("nmtui",)))
    elif wifi:
        rows.append(("Wi-Fi is off", None))
    for name, uuid, typ, active in wired_and_other():
        kind = {"802-3-ethernet": "Wired", "vpn": "VPN", "wireguard": "VPN"}.get(typ, typ)
        rows.append(("%s: %s%s" % (kind, clean(name)[:40], "  (connected - choose to disconnect)" if active else ""),
                     ("toggle", uuid, active)))
    if wifi:
        rows.append(("Turn Wi-Fi off" if radio else "Turn Wi-Fi on", ("radio", "off" if radio else "on")))
        if radio:
            rows.append(("Rescan for networks", ("rescan",)))
        if saved:
            rows.append(("Forget a saved Wi-Fi network...", ("forget",)))
    rows.append(("All network settings (nmtui)...", ("nmtui",)))
    # labels must be unique so a choice maps back to exactly one row
    seen, out = {}, []
    for label, action in rows:
        seen[label] = seen.get(label, 0) + 1
        out.append((label if seen[label] == 1 else "%s (%d)" % (label, seen[label]), action))
    return out


def dmenu(lines, prompt):
    p = subprocess.run(DMENU + ["-p", prompt], input="\n".join(lines) + "\n", capture_output=True, text=True)
    return p.stdout.rstrip("\n") if p.returncode == 0 else None


def message(text):
    """One-line notice, shown as a one-row dmenu. Enter or Esc dismisses it."""
    dmenu([clean(text)[:150]], "Network")


def terminal(*cmd):
    subprocess.Popen(["foot", "-e", *cmd])


def connect(ssid, secured, uuid, in_use):
    if in_use:
        message("Already connected to %s" % ssid)
        return
    if uuid:
        ok, _, err = nmcli("connection", "up", "uuid", uuid, timeout=60)
    elif not secured:
        ok, _, err = nmcli("device", "wifi", "connect", ssid, timeout=60)
    else:
        # asks for the password in a terminal, then waits so any error stays readable
        terminal("sh", "-c",
                 'nmcli --ask device wifi connect "$1"; echo; printf "Press Enter to close "; read -r _',
                 "sh", ssid)
        return
    if not ok:
        message("Could not connect to %s: %s" % (ssid, err or "unknown error"))


def run_action(action):
    kind = action[0]
    if kind == "connect":
        connect(*action[1:])
    elif kind == "toggle":
        _, uuid, active = action
        ok, _, err = nmcli("connection", "down" if active else "up", "uuid", uuid, timeout=60)
        if not ok:
            message(err or "failed")
    elif kind == "radio":
        nmcli("radio", "wifi", action[1])
    elif kind == "rescan":
        nmcli("device", "wifi", "rescan")
        # scan results arrive a moment later: show the menu again with fresh data
        time.sleep(3)
        run_menu()
    elif kind == "forget":
        profiles = saved_profiles()
        pick = dmenu(sorted(profiles, key=str.lower), "Forget")
        if pick in profiles and dmenu(["Yes, forget " + pick, "Cancel"], "Sure?") == "Yes, forget " + pick:
            nmcli("connection", "delete", "uuid", profiles[pick])
    elif kind == "nmtui":
        terminal("nmtui")


def run_menu():
    if not shutil.which("nmcli"):
        message("NetworkManager (nmcli) is not installed")
        return
    rows = build_menu()
    choice = dmenu([label for label, _ in rows], "Network")
    for label, action in rows:
        if label == choice and action:
            run_action(action)
            return


if __name__ == "__main__":
    run_menu()
