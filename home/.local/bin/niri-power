#!/usr/bin/env python3
"""
niri-power: battery details and power profile, from dmenu (for laptops).

  niri-power    show battery level, time left, power draw and health;
               pick a power profile to switch to it (needs power-profiles-daemon)

The battery percentage in the bar comes from niri-status. Bound to Mod+Shift+P in ~/.config/niri/config.kdl.
"""
import glob
import shutil
import subprocess

DMENU = ["dmenu", "-i", "-l", "12"]
PS = "/sys/class/power_supply"


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def number(path):
    v = read(path)
    try:
        return float(v)
    except (TypeError, ValueError):
        return None


def batteries():
    return sorted(glob.glob(PS + "/BAT*"))


def on_ac():
    return any(read(d + "/type") == "Mains" and read(d + "/online") == "1" for d in glob.glob(PS + "/*"))


def battery_totals(bats):
    """Sum energy in microwatt-hours over all batteries (charge x voltage when only charge is given)."""
    now = full = design = power = 0.0
    for b in bats:
        volt = (number(b + "/voltage_now") or number(b + "/voltage_min_design") or 0) / 1e6
        e_now, e_full, e_des, p = (number(b + "/energy_now"), number(b + "/energy_full"),
                                   number(b + "/energy_full_design"), number(b + "/power_now"))
        if e_now is None and volt:
            c_now, c_full, c_des, cur = (number(b + "/charge_now"), number(b + "/charge_full"),
                                         number(b + "/charge_full_design"), number(b + "/current_now"))
            e_now = c_now * volt if c_now is not None else None
            e_full = c_full * volt if c_full is not None else None
            e_des = c_des * volt if c_des is not None else None
            p = abs(cur) * volt if cur is not None else p
        now += e_now or 0
        full += e_full or 0
        design += e_des or 0
        power += abs(p or 0)
    return now, full, design, power


def hours(h):
    m = int(round(h * 60))
    return "%dh %02dm" % (m // 60, m % 60) if m >= 60 else "%d min" % m


def profile_lines():
    if not shutil.which("powerprofilesctl"):
        return []
    try:
        cur = subprocess.run(["powerprofilesctl", "get"], capture_output=True, text=True, timeout=5).stdout.strip()
        listing = subprocess.run(["powerprofilesctl", "list"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    names = [l.strip().lstrip("* ").rstrip(":") for l in listing.splitlines()
             if l.strip().endswith(":") and not l.startswith("    ")]
    rows = [("Power profile: %s" % cur, None)]
    for n in names:
        rows.append(("  switch to %s" % n, ("profile", n)) if n != cur else ("  %s (current)" % n, None))
    return rows


def build_menu():
    bats = batteries()
    if not bats:
        return [("(no battery found - this looks like a desktop)", None)]
    rows = []
    now, full, design, power = battery_totals(bats)
    caps = [number(b + "/capacity") for b in bats if number(b + "/capacity") is not None]
    pct = round(now / full * 100) if full else (round(sum(caps) / len(caps)) if caps else 0)
    states = {read(b + "/status", "Unknown") for b in bats}
    status = "Charging" if "Charging" in states else "Discharging" if "Discharging" in states else \
        "Full" if states == {"Full"} else "Not charging" if "Not charging" in states else sorted(states)[0]
    line = "Battery %d%%  %s" % (pct, status.lower())
    if power > 0 and full:
        if status == "Discharging":
            line += "  %s left" % hours(now / power)
        elif status == "Charging":
            line += "  %s until full" % hours((full - now) / power)
    rows.append((line, None))
    rows.append(("Power source: " + ("mains adapter" if on_ac() else "battery"), None))
    if power > 0:
        rows.append(("Power draw: %.1f W" % (power / 1e6), None))
    if design and full:
        cycles = [number(b + "/cycle_count") for b in bats if number(b + "/cycle_count")]
        rows.append(("Health: %d%% of original capacity%s" % (round(full / design * 100),
                     "  (%d charge cycles)" % max(cycles) if cycles else ""), None))
    limits = [number(b + "/charge_control_end_threshold") for b in bats]
    if any(v is not None for v in limits):
        rows.append(("Charge limit: stops at %d%%" % max(v for v in limits if v is not None), None))
    rows += profile_lines()
    return rows


def run_menu():
    rows = build_menu()
    p = subprocess.run(DMENU + ["-p", "Power"], input="\n".join(l for l, _ in rows) + "\n",
                       capture_output=True, text=True)
    if p.returncode != 0:
        return
    choice = p.stdout.rstrip("\n")
    for label, action in rows:
        if label == choice and action and action[0] == "profile":
            subprocess.run(["powerprofilesctl", "set", action[1]], capture_output=True, timeout=10)


if __name__ == "__main__":
    run_menu()
