#!/usr/bin/env python3
"""
obs-clip: save the last 30 seconds from OBS's replay buffer, plus a copy that fits on Discord.

  obs-clip    save the clip (~/Videos/OBS/Replay <date>.mp4), then make <name>.discord.mp4 next to
              it with discord-compress (under Discord's 10 MB free upload limit)

Desktops only: install.sh binds it to Alt+F10 in ~/.config/niri/local.kdl and starts OBS with the
replay buffer at login. OBS's own hotkeys don't work under Wayland, so this asks OBS over its
websocket, with the password install.sh generated in OBS's websocket config.
"""
import base64
import hashlib
import json
import os
import subprocess
import sys

from websockets.sync.client import connect

CONFIG = os.path.expanduser("~/.config/obs-studio/plugin_config/obs-websocket/config.json")
COMPRESS = os.path.expanduser("~/.local/bin/discord-compress")
OUTPUT_EVENTS = 1 << 6  # obs-websocket event subscription that carries ReplayBufferSaved


def notify(*args):
    subprocess.run(["notify-send", *args])


def sha256_b64(s):
    return base64.b64encode(hashlib.sha256(s.encode()).digest()).decode()


def save_replay():
    """Ask OBS to save the replay buffer; returns the saved file's path once OBS has written it."""
    with open(CONFIG) as f:
        cfg = json.load(f)
    with connect(f"ws://localhost:{cfg.get('server_port', 4455)}", open_timeout=3) as ws:
        hello = json.loads(ws.recv(timeout=5))["d"]
        identify = {"rpcVersion": 1, "eventSubscriptions": OUTPUT_EVENTS}
        if "authentication" in hello:
            auth = hello["authentication"]
            secret = sha256_b64(cfg["server_password"] + auth["salt"])
            identify["authentication"] = sha256_b64(secret + auth["challenge"])
        ws.send(json.dumps({"op": 1, "d": identify}))
        ws.recv(timeout=5)  # Identified
        ws.send(json.dumps({"op": 6, "d": {"requestType": "SaveReplayBuffer", "requestId": "clip"}}))
        while True:
            msg = json.loads(ws.recv(timeout=15))
            d = msg["d"]
            if msg["op"] == 7 and not d["requestStatus"]["result"]:
                raise RuntimeError(d["requestStatus"].get("comment", "OBS refused to save"))
            if msg["op"] == 5 and d["eventType"] == "ReplayBufferSaved":
                return d["eventData"]["savedReplayPath"]


try:
    clip = save_replay()
except Exception as e:
    notify("-u", "critical", "Clip failed", f"Is OBS running with the replay buffer on? ({e})")
    sys.exit(1)

notify("Clip saved", "Compressing for Discord...")
r = subprocess.run([COMPRESS, clip], capture_output=True, text=True)
if r.returncode:
    notify("-u", "critical", "Discord copy failed", r.stderr.strip()[-300:])
    sys.exit(1)
notify("Discord clip ready", r.stdout.strip().splitlines()[-1])
