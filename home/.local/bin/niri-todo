#!/usr/bin/env python3
"""
niri-todo: Canvas + Schoology assignments, your own to-dos and workouts in the bar, with points,
a streak and reminders.

  niri-todo daemon    sync every 5 min, refresh the bar and send reminders every minute (started by niri)
  niri-todo sync      sync once and print the bar text and any errors
  niri-todo menu      dmenu: next task, 10-minute focus timer, open / mark done (Mod+T in ~/.config/niri/config.kdl)
  niri-todo selftest  check the feed parser, ordering and scoring

Setup, in ~/.local/share/dwm-todo/ (share that folder with Syncthing to keep machines in step):
  canvas_token     Canvas access token (Account > Settings > New Access Token), chmod 600
  dwm-todo.conf    canvas_url=https://yourschool.instructure.com
                   canvas_token_expires=2027-01-01  (warns daily in the last week)
                   schoology_ics=webcal://...  (Schoology calendar export link)
  todo.txt         your own tasks, one per line: 2026-10-13 20:00 Poster board  (time optional: end of day)
  .stignore        tasks.json, lock, daemon.lock, *.tmp  (per machine; state.json is what syncs)

Points: on time +10, late +3, missing 0 (no penalties: they teach avoiding the tracker); +5 more for
turning work in 24 hours or more early; about 1 in 4 completions pays double, decided per task so every
machine agrees. Canvas reports status itself (nothing due before the first sync counts); Schoology's feed
can't, so you mark those (and todo.txt tasks) done from the menu. A workout is a task every Sunday, Monday,
Wednesday and Friday, checked off from the menu that day only. A finished focus session is +2. Every 100 points is a level.
The streak is days in a row with something turned in on time or a finished focus session; every 7 active
days earn a streak freeze (up to 2), which a missed day uses up instead of ending the streak. Reminders go out 3 days and 1 day before a due date, then every 30 minutes in the last 3 hours, plus a summary each morning.
"""
import fcntl
import glob
import math
import json
import os
import random
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from contextlib import contextmanager
from datetime import date, datetime, timedelta, timezone
from urllib.parse import urlencode
from urllib.error import HTTPError
from urllib.request import Request, urlopen
from zoneinfo import ZoneInfo

HOME = os.path.expanduser("~")
# Still named after dwm: Syncthing points at this folder on every machine.
DATA = os.path.join(os.environ.get("XDG_DATA_HOME", f"{HOME}/.local/share"), "dwm-todo")
CONF = f"{DATA}/dwm-todo.conf"
TODO = f"{DATA}/todo.txt"
TOKEN = f"{DATA}/canvas_token"
RUN = os.environ.get("XDG_RUNTIME_DIR", f"{HOME}/.cache")
BAR = f"{RUN}/niri-todo-bar"      # one line, read by niri-status
ANKI_COUNT = f"{RUN}/niri-todo-anki"  # "<date> <due>", written by the Anki add-on after each answered card
PIDFILE = f"{RUN}/niri-todo.pid"  # the daemon; the Anki add-on sends it SIGUSR1 after every answered card
STICKY = f"{RUN}/niri-todo-sticky"  # ids of notifications that stay until clicked; Mod+t closes them
FOCUS = f"{RUN}/niri-todo-focus"  # "<end epoch> <icon> <text>": the running focus/break timer, read by niri-status
DMENU = ["dmenu", "-i", "-l", "15"]

LOOKBACK = 14 * 86400  # overdue work older than this drops off the list
AHEAD = 60 * 86400
SYNC_EVERY = 300
ANKI_EVERY = 5  # while Anki is open, its count refreshes this often
FOCUS_SECS = 600
REST_SECS = 300
NEXT_WINDOW = 1800  # after a session or break, the menu offers 10 more minutes for this long
NAG = 3 * 3600  # in the last 3 hours: a reminder every 30 minutes
REMIND = [3 * 86400, 86400] + list(range(NAG, 0, -1800))  # seconds before due, longest first
PTS = {"done": 10, "late": 3, "missing": 0}  # no penalty: punishment teaches avoiding the tracker
EARLY, EARLY_BONUS = 86400, 5  # turned in this long before it's due: bonus points
SURPRISE = 0.25  # chance a completion pays double, fixed per task so every machine agrees
LEVEL = 100  # points per level
FREEZE_EVERY, MAX_FREEZES = 7, 2  # active days that earn a streak freeze, and how many can be banked
# Bar icons (Symbols Nerd Font): graduation cap, warning, coffee, star, flame
TIMER = "󰔛"
CAP, WARN, COFFEE, STAR, FIRE = "", "", "󰅶", "", "󰈸"
PRIORITY = {"canvas": 1, "schoology": 2, "todo": 2, "anki": 3, "workout": 4}  # breaks ties on the same day
MANUAL = ("schoology", "todo", "workout")  # nothing reports these done: they're checked off from the menu
LATE_FIRST = 2 * 86400  # nothing due within this long: late work moves to the top
MANUAL_LATE = 7 * 86400  # late manual work stays listed this long (nothing can say it was turned in)
WORKOUT_DAYS = (6, 0, 2, 4)  # date.weekday(): Sunday, Monday, Wednesday, Friday
BREAK = 3 * 86400  # nothing late and nothing due within this long: a break (ends when the 3-day reminder fires)


# ---- storage ----

def load(name, default):
    # Only a missing file falls back to the default: a corrupt state.json must not silently zero the points.
    try:
        with open(f"{DATA}/{name}") as f:
            return json.load(f)
    except FileNotFoundError:
        return default


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as f:
        f.write(text)
    os.replace(path + ".tmp", path)


@contextmanager
def state():
    """Load, modify and save state.json under a lock (the daemon, menu and focus timer all write it).
    Saved only when something changed, so a synced copy on another machine isn't overwritten every minute."""
    os.makedirs(DATA, exist_ok=True)
    with open(f"{DATA}/lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        s = load("state.json", {})
        before = json.dumps(s)  # taken before migrate, so a migrated file gets saved
        migrate(s)
        # Two machines changed state.json at once: Syncthing kept one and saved the other as a
        # conflict copy. Fold the copy back in so nothing done on either machine is lost.
        merged = []
        for f in glob.glob(f"{DATA}/state.sync-conflict-*.json"):
            try:
                with open(f) as fh:
                    merge(s, json.load(fh))
                merged.append(f)
            except (OSError, ValueError):
                pass  # still arriving: next time
        yield s
        if json.dumps(s) != before:
            write(f"{DATA}/state.json", json.dumps(s))
        for f in merged:
            os.remove(f)


def migrate(s):
    """Fill in defaults. focus_pts (a running total) became focus (one entry per finished session),
    which two machines can merge; the old total turns into numbered entries, the same on every machine."""
    for k, v in {"scores": {}, "hidden": [], "reminded": [], "focus": [], "days": []}.items():
        s.setdefault(k, v)
    legacy = [f"legacy-{i}" for i in range(1, s.pop("focus_pts", 0) // 2 + 1)]
    for v in s["scores"].values():  # missing work used to cost 5 points; it costs nothing now
        v["pts"] = max(v["pts"], 0)
    s["focus"] += [x for x in legacy if x not in s["focus"]]
    return s


def merge(s, other):
    """Fold another machine's copy into s. Everything only grows, so the union keeps both sides' work."""
    other = migrate(other)
    for k, v in other["scores"].items():
        s["scores"].setdefault(k, v)
    for key in ("hidden", "reminded", "focus", "days"):
        s[key] += [x for x in other[key] if x not in s[key]]
    s["days"].sort()
    for key in ("summary_day", "anki_day", "token_warned"):  # ISO dates: the later one
        if other.get(key, "") > s.get(key, ""):
            s[key] = other[key]
    if "since" in other:
        s["since"] = min(s.get("since", other["since"]), other["since"])


def config():
    conf = {}
    try:
        with open(CONF) as f:
            for line in f:
                k, sep, v = line.strip().partition("=")
                if sep and not k.startswith("#"):
                    conf[k.strip()] = v.strip()
    except FileNotFoundError:
        pass
    return conf


# ---- fetching ----

def course_name(name):
    """'202660_1_ON_ENGL101_60413' -> 'ENGL101'; names without a course code stay as they are."""
    m = re.search(r"(?<![A-Z])[A-Z]{2,5} ?\d{3}[A-Z]?(?!\d)", name)
    return m.group(0) if m else name


def canvas_tasks(base):
    base = base.rstrip("/")
    if not base.startswith("https://"):
        raise ValueError("canvas_url must start with https://")
    with open(TOKEN) as f:
        token = f.read().strip()
    now = time.time()
    iso = lambda t: datetime.fromtimestamp(t, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    url = f"{base}/api/v1/planner/items?" + urlencode(
        {"start_date": iso(now - LOOKBACK), "end_date": iso(now + AHEAD), "per_page": 100})
    tasks = []
    while url:
        if not url.startswith(base + "/"):
            raise ValueError(f"refusing to send the Canvas token to {url}")
        with urlopen(Request(url, headers={"Authorization": f"Bearer {token}"}), timeout=30) as r:
            items = json.load(r)
            m = re.search(r'<([^>]+)>;\s*rel="next"', r.headers.get("Link", ""))
            url = m and m.group(1)
        for it in items:
            sub, p = it.get("submissions"), it.get("plannable") or {}
            due = p.get("due_at") or it.get("plannable_date")
            # Announcements and calendar events have no submission; excused work doesn't count.
            if not isinstance(sub, dict) or not due or sub.get("excused"):
                continue
            due = datetime.fromisoformat(due).timestamp()
            if sub.get("submitted") or sub.get("graded") or (it.get("planner_override") or {}).get("marked_complete"):
                status = "late" if sub.get("late") else "done"
            else:
                status = "missing" if sub.get("missing") or due < now else "todo"
            link = it.get("html_url") or ""
            tasks.append({"id": f"c:{it['plannable_type']}:{it['plannable_id']}", "source": "canvas",
                          "title": p.get("title") or p.get("name") or "?", "course": course_name(it.get("context_name") or ""),
                          "due": due, "status": status, "url": base + link if link.startswith("/") else base})
    return tasks


def ics_time(params, val):
    tz = next((p[5:] for p in params if p.startswith("TZID=")), None)
    if len(val) == 8:  # all-day: due at the end of that day
        return datetime.strptime(val, "%Y%m%d").replace(hour=23, minute=59).timestamp()
    if val.endswith("Z"):
        return datetime.strptime(val, "%Y%m%dT%H%M%SZ").replace(tzinfo=timezone.utc).timestamp()
    d = datetime.strptime(val, "%Y%m%dT%H%M%S")
    return (d.replace(tzinfo=ZoneInfo(tz)) if tz else d).timestamp()  # naive = local time


def parse_ics(text):
    text = re.sub(r"\r?\n[ \t]", "", text)  # unfold continuation lines
    events = []
    for block in text.split("BEGIN:VEVENT")[1:]:
        f = {}
        for line in block.split("END:VEVENT")[0].splitlines():
            key, _, val = line.partition(":")
            name, *params = key.split(";")
            f.setdefault(name.upper(), (params, val))
        if "DTSTART" not in f:
            continue
        title = re.sub(r"\\(.)", lambda m: " " if m.group(1) in "nN" else m.group(1), f.get("SUMMARY", ([], "?"))[1])
        events.append({"id": "s:" + f.get("UID", ([], title + f["DTSTART"][1]))[1], "source": "schoology",
                       "title": title, "course": "Schoology", "due": ics_time(*f["DTSTART"]), "url": f.get("URL", ([], ""))[1]})
    return events


def schoology_tasks(feed):
    if feed.startswith("/"):  # a downloaded .ics: a snapshot, so new assignments won't show up
        with open(feed, encoding="utf-8", errors="replace") as f:
            events = parse_ics(f.read())
    else:
        feed = re.sub(r"^webcal://", "https://", feed)
        with urlopen(Request(feed, headers={"User-Agent": "niri-todo"}), timeout=30) as r:
            events = parse_ics(r.read().decode("utf-8", "replace"))
    now = time.time()
    # Calendar events (fundraisers, meetings) link to /event/; everything else is work to turn in.
    return [dict(e, url=re.sub(r"^http://", "https://", e["url"])) for e in events
            if "/event/" not in e["url"] and now - LOOKBACK < e["due"] < now + AHEAD]


def tonight():
    return datetime.now().replace(hour=23, minute=59, second=0, microsecond=0).timestamp()


def parse_todo(text):
    """todo.txt lines: "2026-10-13 20:00 Poster board", the time optional (then due at 23:59)."""
    tasks = []
    for line in text.splitlines():
        m = re.match(r"(\d{4}-\d{2}-\d{2})(?: (\d{1,2}:\d{2}))? +(\S.*)", line.strip())
        if m:
            due = datetime.strptime(f"{m[1]} {m[2] or '23:59'}", "%Y-%m-%d %H:%M").timestamp()
            tasks.append({"id": f"t:{m[1]} {m[3]}", "source": "todo", "title": m[3], "course": "",
                          "due": due, "status": "todo", "url": ""})
    return tasks


def todo_tasks():
    try:
        with open(TODO) as f:
            return parse_todo(f.read())
    except FileNotFoundError:
        return []


def workout_task():
    """Only ever today's, on a workout day: it can't be done ahead for another day, and a missed day just goes away."""
    if date.today().weekday() not in WORKOUT_DAYS:
        return None
    return {"id": f"workout:{date.today().isoformat()}", "source": "workout", "title": "Workout",
            "course": "", "due": tonight(), "status": "todo", "url": ""}


def anki_due():
    """Cards due today in the local Anki collection, or None without Anki. Counted on a copy, so the
    real collection is never touched, even while Anki has it open."""
    try:
        from anki.collection import Collection
    except ImportError:
        return None
    cols = sorted(glob.glob(os.path.expanduser("~/.local/share/Anki2/*/collection.anki2")))
    if not cols:
        return None
    # The add-on's own count is instant; trust it while nothing has touched the collection since
    # (an undo or an edit in the browser changes the files, and then we count a copy instead).
    try:
        with open(ANKI_COUNT) as f:
            day, n = f.read().split()
        newest = max(os.stat(c).st_mtime for c in (cols[0], cols[0] + "-wal") if os.path.exists(c))
        if day == date.today().isoformat() and os.stat(ANKI_COUNT).st_mtime >= newest:
            return int(n)
    except (OSError, ValueError):
        pass
    with tempfile.TemporaryDirectory() as tmp:
        for suffix in ("", "-wal"):  # the -wal file holds changes Anki hasn't written into the main file yet
            if os.path.exists(cols[0] + suffix):
                shutil.copy2(cols[0] + suffix, tmp)
        col = Collection(os.path.join(tmp, "collection.anki2"))
        try:
            return sum(n.new_count + n.learn_count + n.review_count for n in col.sched.deck_due_tree().children)
        finally:
            col.close()


def sync():
    conf = config()
    old = load("tasks.json", {"tasks": []})["tasks"]
    tasks, errors = [], []
    if not conf.get("canvas_url") and not conf.get("schoology_ics"):
        errors.append(f"not set up: fill in {CONF}")
    for source, key, fetch in (("canvas", "canvas_url", canvas_tasks), ("schoology", "schoology_ics", schoology_tasks)):
        if not conf.get(key):
            continue
        try:
            tasks += fetch(conf[key])
        except Exception as e:  # offline or a bad token: keep showing the last good copy
            expired = source == "canvas" and isinstance(e, HTTPError) and e.code == 401
            errors.append("canvas: token expired or wrong, make a new one and update canvas_token_expires" if expired
                          else f"{source}: {e}")
            tasks += [t for t in old if t["source"] == source]
    try:
        tasks += todo_tasks()
    except ValueError as e:  # a bad date in todo.txt
        errors.append(f"todo.txt: {e}")
        tasks += [t for t in old if t["source"] == "todo"]
    if workout := workout_task():
        tasks.append(workout)
    with state() as s:
        s.setdefault("since", time.time())
        for t in tasks:
            if t["source"] == "canvas":
                score_canvas(s, t)
    return update_anki(tasks, errors)


def update_anki(tasks, errors):
    """Count today's Anki cards, score finishing them, and save the task list with the Anki task."""
    try:
        cards = anki_due()
    except Exception as e:
        errors.append(f"anki: {e}")
        cards = None
    # Anki is a task for today only: finishing today's cards (due goes from some to none) scores it.
    today, anki_id = date.today().isoformat(), f"anki:{date.today().isoformat()}"
    with state() as s:
        if cards:
            s["anki_day"] = today
        elif cards == 0 and s.get("anki_day") == today and anki_id not in s["scores"]:
            award(s, {"id": anki_id, "title": "Anki reviews done", "due": tonight()}, "done")
        anki_done = anki_id in s["scores"]
        focusing_anki = s.get("focus_task") == anki_id
    if focusing_anki and focus_end(TIMER) > time.time():  # keep the focus timer's text counting down too
        write(FOCUS, f"{focus_end()} {TIMER} {'Anki: done' if anki_done else f'Anki: {cards} cards'}\n")
    if cards and not anki_done:
        tasks.append({"id": anki_id, "source": "anki", "title": f"Anki: {cards} cards", "course": "",
                      "due": tonight(), "status": "todo", "url": ""})
    write(f"{DATA}/tasks.json", json.dumps({"tasks": tasks, "errors": errors}))
    return errors


def anki_refresh():
    """Re-count just Anki (cheap), keeping the last Canvas/Schoology fetch, so the bar ticks down while you study."""
    data = load("tasks.json", {"tasks": [], "errors": []})
    update_anki([t for t in data["tasks"] if t["source"] != "anki"],
                [e for e in data["errors"] if not e.startswith("anki:")])


def anki_running():
    return subprocess.run(["pgrep", "-f", "^/usr/bin/python /usr/bin/anki"], capture_output=True).returncode == 0


# ---- points ----

def session_id():
    """One finished focus session: when, and on which machine, so two machines' sessions never collide."""
    return f"{datetime.now().isoformat(timespec='seconds')} {os.uname().nodename}"


def total(s):
    return 2 * len(s["focus"]) + sum(v["pts"] for v in s["scores"].values())


def active(s):
    """Today counts toward the streak: something went in on time, or a focus session finished."""
    today = date.today().isoformat()
    if today not in s.setdefault("days", []):
        s["days"].append(today)


def streak_info(s, today=None):
    """(days in a row, freezes banked). Every FREEZE_EVERY active days in a run earn a freeze (up to
    MAX_FREEZES), and a missed day spends one instead of ending the run. Worked out from the days list
    alone, so it merges across machines. Today only counts against you once it's over."""
    have = set(s.get("days", []))
    if not have:
        return 0, 0
    today = today or date.today()
    d, run, freezes = date.fromisoformat(min(have)), 0, 0
    while d <= today:
        if d.isoformat() in have:
            run += 1
            if run % FREEZE_EVERY == 0:
                freezes = min(freezes + 1, MAX_FREEZES)
        elif d < today:
            if freezes:
                freezes -= 1
            else:
                run = 0
        d += timedelta(days=1)
    return run, freezes


def streak(s, today=None):
    return streak_info(s, today)[0]


def level_info(pts):
    """(level, points to the next one)."""
    return pts // LEVEL + 1, LEVEL - pts % LEVEL


def level_up(s, before):
    lvl = level_info(total(s))[0]
    if lvl > level_info(before)[0]:
        notify(f"Level {lvl}!", f"{total(s)} pts", urgent=True)


def award(s, t, status):
    """Score a finished task: base points, the early bonus, and sometimes double."""
    pts, notes = PTS[status], []
    if status == "done" and time.time() <= t["due"] - EARLY:
        pts += EARLY_BONUS
        notes.append(f"+{EARLY_BONUS} for being early")
    if pts > 0 and random.Random(t["id"]).random() < SURPRISE:
        pts *= 2
        notes.append("surprise: double points!")
    s["scores"][t["id"]] = {"pts": pts, "due": t["due"], "on_time": status == "done", "status": status}
    if pts > 0:
        cheer(s, t, pts, notes)


def cheer(s, t, pts, notes=()):
    freezes_before = streak_info(s)[1]
    if pts >= PTS["done"]:  # on time
        active(s)
    run, freezes = streak_info(s)
    lvl, to_next = level_info(total(s))
    notify(f"+{pts} pts: {t['title']}",
           " · ".join([*notes, f"{total(s)} pts", f"Lv {lvl}, {to_next} to Lv {lvl + 1}", f"{run}-day streak"]))
    level_up(s, total(s) - pts)
    if freezes > freezes_before:
        notify("Streak freeze earned", "If you miss a day, it saves your streak.")


def score_canvas(s, t):
    if t["due"] < s["since"]:  # fresh start: nothing due before the first sync counts
        return
    old = s["scores"].get(t["id"])
    if t["status"] not in PTS:
        s["scores"].pop(t["id"], None)
        return
    if old and old.get("status", legacy_status(old)) == t["status"]:
        return  # already scored as this: an early or surprise bonus isn't worked out again
    award(s, t, t["status"])


def legacy_status(score):
    """Scores from before "status" was stored."""
    return "done" if score["on_time"] else "late" if score["pts"] > 0 else "missing"


def mark_done(t, on_time=None):
    """Schoology work checked off by hand. on_time defaults to whether it's past due right now.
    Work due before the first sync is just cleared with no points (the same fresh start as Canvas),
    unless on_time is given: finished on another device and only marked here now."""
    with state() as s:
        if on_time is None and t["due"] < s.get("since", 0):
            s["hidden"].append(t["id"])
            return
        if on_time is None:
            on_time = time.time() <= t["due"]
        award(s, t, "done" if on_time else "late")


# ---- what's next ----

def todo(tasks, s, now):
    """Unfinished work (the bar shows only the first, never a count of late work): upcoming first, by day, then
    PRIORITY (Canvas, Schoology, Anki, workout) on the same day; then overdue,
    most recent first (likeliest to still be accepted). With nothing due soon, overdue goes first."""
    keep = [t for t in tasks if t["id"] not in s["hidden"] and (
        t["status"] in ("todo", "missing") if t["source"] not in MANUAL
        else t["id"] not in s["scores"] and t["due"] > now - (0 if t["source"] == "workout" else MANUAL_LATE))]
    day = lambda t: time.strftime("%Y%m%d", time.localtime(t["due"]))
    items = sorted(keep, key=lambda t: (False, day(t), PRIORITY[t["source"]], t["due"]) if t["due"] >= now
                   else (True, -t["due"]))
    n = sum(t["due"] >= now for t in items)
    if not n or items[0]["due"] - now > LATE_FIRST:
        items = items[n:] + items[:n]
    return items


def left(secs, units=2):
    """Rounded down (never more time than there is): 1d 23h, 3h 5m, 45m; units=1 gives 1d, 3h (the menu)."""
    m = int(abs(secs)) // 60
    d, h, m = m // 1440, m // 60 % 24, m % 60
    big, small = ((d, "d"), (h, "h")) if d else ((h, "h"), (m, "m")) if h else ((m, "m"), (0, ""))
    txt = f"{big[0]}{big[1]}" + (f" {small[0]}{small[1]}" if small[0] and units > 1 else "")
    return f"{txt} late" if secs < 0 else txt


def short(title, n=28):
    return title if len(title) <= n else title[:n - 2] + ".."


def break_until(items, now):
    """End of the current break, or None. A break is earned: nothing late, nothing due within BREAK."""
    if items and all(t["due"] - now > BREAK for t in items):
        return items[0]["due"] - BREAK
    return None


def bar_text(tasks, errors, s, now):
    items = todo(tasks, s, now)
    free = break_until(items, now)
    if free and not errors:
        return f"{COFFEE} free until {time.strftime('%a %-m/%-d', time.localtime(free))} | {STAR} {total(s)} {FIRE} {streak(s)}"
    if items:
        head = f"{short(items[0]['title'])} ({left(items[0]['due'] - now)})"
    else:
        head = "run niri-todo sync" if errors and not tasks else "all caught up"
    parts = [(f"{WARN} " if errors else f"{CAP} ") + head]
    parts.append(f"{STAR} {total(s)} {FIRE} {streak(s)}")
    return " | ".join(parts)


def notify(title, body="", urgent=False, tag=None):
    """Urgent ones stay until clicked (dunstrc) or until Mod+t opens the menu (close_sticky).
    A tag replaces the shown notification with the same tag instead of stacking under it."""
    hint = ["-h", f"string:x-dunst-stack-tag:{tag}"] if tag else []
    try:
        p = subprocess.run(["notify-send", "-p", "-a", "niri-todo", "-u", "critical" if urgent else "normal",
                            *hint, title, body], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return
    if urgent and p.stdout.strip().isdigit():
        with open(STICKY, "a") as f:
            f.write(p.stdout.strip() + "\n")


def close_sticky():
    """Opening the menu means they've been seen."""
    try:
        with open(STICKY) as f:
            ids = f.read().split()
        os.remove(STICKY)
    except OSError:
        return
    for i in ids:
        subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                        "--object-path", "/org/freedesktop/Notifications",
                        "--method", "org.freedesktop.Notifications.CloseNotification", i],
                       capture_output=True, timeout=10)


def remind(s, items, now):
    # Never pruned: each machine's task list differs, and pruning to this one's let the machines erase each
    # other's keys through Syncthing every minute, re-sending the same reminder. A few keys per task is tiny.
    for t in items:
        keys = [f"{t['id']}@{secs}" for secs in REMIND if 0 < t["due"] - now <= secs]
        # One notification per threshold, even when the first sync crosses several at once.
        if keys and keys[-1] not in s["reminded"]:
            notify(f"Due in {left(t['due'] - now)}: {t['title']}", t["course"], tag=t["id"])
            s["reminded"] += [k for k in keys if k not in s["reminded"]]


def summary(s, items, now):
    today = time.strftime("%Y-%m-%d")
    if s.get("summary_day") == today or time.localtime().tm_hour < 7:
        return
    s["summary_day"] = today
    free = break_until(items, now)
    if free:
        notify(f"Break day: free until {time.strftime('%a %-m/%-d', time.localtime(free))}", "Nothing due for 3+ days. Enjoy it.")
        return
    end_today = datetime.now().replace(hour=23, minute=59, second=59).timestamp()
    week = [t for t in items if now <= t["due"] <= now + 7 * 86400]
    n_today = sum(t["due"] <= end_today for t in week)
    body = "\n".join(f"{left(t['due'] - now):>6}  {t['title']}" for t in week[:6]) or "Nothing due this week."
    yesterday = (date.today() - timedelta(days=1)).isoformat()
    if yesterday not in s.get("days", []) and streak(s) > 0:
        body = "A streak freeze saved your streak yesterday.\n" + body
    notify(f"{n_today} due today, {len(week)} this week. {total(s)} pts", body)


def token_warning(s, now):
    """Canvas tokens at this school last at most 90 days: warn daily in the last week."""
    exp, today = config().get("canvas_token_expires"), time.strftime("%Y-%m-%d")
    if not exp or s.get("token_warned") == today:
        return
    days = (datetime.strptime(exp, "%Y-%m-%d").timestamp() - now) / 86400
    if days <= 7:
        s["token_warned"] = today
        notify(f"Canvas token expires in {max(0, math.ceil(days))} days",
               f"Account > Settings > New Access Token, save it to {TOKEN}, update dwm-todo.conf", urgent=True)


def tick():
    data = load("tasks.json", {"tasks": [], "errors": []})
    now = time.time()
    with state() as s:
        items = todo(data["tasks"], s, now)
        remind(s, items, now)
        summary(s, items, now)
        token_warning(s, now)
        write(BAR, bar_text(data["tasks"], data["errors"], s, now) + "\n")


def daemon():
    os.makedirs(DATA, exist_ok=True)
    lock = open(f"{DATA}/daemon.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit("niri-todo daemon is already running")
    write(PIDFILE, f"{os.getpid()}\n")
    # SIGUSR1 (from the Anki add-on, after each answered card) is taken by sigtimedwait below, which
    # wakes the loop at once instead of at its next interval.
    signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGUSR1})
    last, anki_was_open, poked = 0, False, False
    while True:
        anki_open = anki_running()
        steps = [tick]
        if time.time() - last >= SYNC_EVERY:  # failures wait for the next interval too
            last = time.time()
            steps = [sync, tick]
        elif poked or anki_open or anki_was_open:  # while studying, and once more right after Anki closes
            steps = [anki_refresh, tick]
        anki_was_open = anki_open
        for step in steps:
            try:
                step()
            except Exception as e:
                print(f"niri-todo {step.__name__}: {e}", file=sys.stderr)
        if poked:
            redraw_bar()
        poked = signal.sigtimedwait([signal.SIGUSR1], ANKI_EVERY if anki_open else 60) is not None


def redraw_bar():
    """niri-status redraws right away on SIGUSR1 instead of on its next one-second tick."""
    try:
        with open(f"{RUN}/niri-status.pid") as f:
            os.kill(int(f.read()), signal.SIGUSR1)
    except (OSError, ValueError):
        pass


# ---- menu ----

def focus_end(kind=None):
    """End time of the running timer (only if its icon is `kind`, when given), else 0."""
    try:
        with open(FOCUS) as f:
            end, icon = f.read().split()[:2]
        return int(end) if kind in (None, icon) else 0
    except (OSError, ValueError):
        return 0


def open_url(t):
    if t["source"] == "anki":
        subprocess.Popen(["anki"], start_new_session=True)  # an already-open Anki just comes to the front
    elif t["url"].startswith("https://"):
        subprocess.Popen(["xdg-open", t["url"]], start_new_session=True)


def timer(secs, icon, text):
    """Count down in the bar. False if it was stopped or another timer replaced it."""
    end = int(time.time()) + secs
    write(FOCUS, f"{end} {icon} {text}\n")
    time.sleep(secs)
    if focus_end() != end:
        return False
    os.remove(FOCUS)
    return True


def focus(t, reopen=True):
    """One 10-minute session. When it ends, a notification points to Mod+t for more or a break:
    nothing pops up that grabs the keyboard while you're typing."""
    if reopen:
        open_url(t)
        notify(f"Focus 10 min: {t['title']}", "Just start. It doesn't have to be good yet.")
    with state() as s:
        s["focus_task"] = t["id"]
        s.pop("focus_next", None)
    if not timer(FOCUS_SECS, TIMER, short(t["title"])):
        return
    with state() as s:
        s["focus"].append(session_id())
        s["focus_next"] = time.time()
        active(s)
        level_up(s, total(s) - 2)
        pts = total(s)
    tick()
    notify(f"Session done: +2 pts ({pts})", "Mod+t: 10 more minutes or a 5-minute break", urgent=True)


def rest(t):
    with state() as s:
        s.pop("focus_next", None)
    if timer(REST_SECS, COFFEE, "break"):
        with state() as s:
            s["focus_next"] = time.time()
        notify(f"Break's over: {t['title']}", "Mod+t: 10 more minutes", urgent=True)


def workout_done(listed):
    """Scores today's workout, and only if that's the one the menu listed: after midnight, yesterday's
    can't be finished late, nor today's checked off from a stale menu."""
    t = workout_task()
    if t and t["id"] == listed["id"]:
        with state() as s:
            if t["id"] not in s["scores"]:
                award(s, t, "done")


def next_session(tasks, s, now):
    """The task to offer "10 more minutes" on: a session or break ended within NEXT_WINDOW."""
    if now - s.get("focus_next", 0) > NEXT_WINDOW:
        return None
    return next((x for x in tasks if x["id"] == s.get("focus_task")), None)


def finish():
    """Done before the timer ran out: the session counts, and the task is checked off."""
    os.remove(FOCUS)  # the timer sees it gone and stops without asking what's next
    tasks = load("tasks.json", {"tasks": []})["tasks"]
    with state() as s:
        s["focus"].append(session_id())
        active(s)
        level_up(s, total(s) - 2)
        t = next((x for x in tasks if x["id"] == s.get("focus_task")), None)
        notify("Finished early: +2 pts", f"{total(s)} pts")
    if t and t["source"] in MANUAL:
        mark_done(t)
    else:
        sync()  # Canvas: picks up the submission (and its +10) now instead of in 5 minutes
    tick()


def dmenu(rows, prompt):
    p = subprocess.run(DMENU + ["-p", prompt], input="\n".join(l for l, _ in rows) + "\n",
                       capture_output=True, text=True)
    choice = p.stdout.rstrip("\n")
    return next((a for l, a in rows if l == choice), None) if p.returncode == 0 else None


def run_menu():
    close_sticky()
    tasks = load("tasks.json", {"tasks": []})["tasks"]
    now = time.time()
    with state() as s:
        items = todo(tasks, s, now)
        (run, freezes), (lvl, to_next) = streak_info(s), level_info(total(s))
        prompt = f"{total(s)} pts · Lv {lvl} ({to_next} to go) · {run}-day streak" + (f" · {freezes} freeze" if freezes else "")
        since = s.get("since", now)
        again = next_session(tasks, s, now)
    rows = []
    first = next((t for t in items if t["source"] != "workout"), None)  # workouts get no focus timer
    if again and not focus_end():
        rows += [(f"10 more minutes: {again['title']}", ("more", again)), ("5-minute break", ("rest", again)),
                 ("Stop for now (not finished)", ("pause", again))]
    if focus_end(TIMER) > now:
        rows.append(("Finished it", ("finish", None)))
    if focus_end() > now:
        rows.append(("Stop timer", ("stop", None)))
    elif first and not again:
        rows.append((f">> Start 10-min focus: {first['title']}", ("focus", first)))
    rows += [(f"{left(t['due'] - now, 1):>8}  {t['course'] + ': ' if t['course'] else ''}{t['title']}", ("task", t))
             for t in items]
    rows.append(("Sync now", ("sync", None)))
    act, t = dmenu(rows, prompt) or (None, None)
    if act == "task":
        sub = [("Start 10-min focus", ("focus", t))]
        if t["source"] == "workout":
            sub = [("Finished", ("workout", t))]
        elif t["source"] == "anki" or t["url"]:
            sub.append(("Open Anki" if t["source"] == "anki" else "Open in browser", ("open", t)))
        if t["source"] in ("schoology", "todo") and t["due"] < now:  # past due: it may have gone in on time anyway
            sub += [("Turned it in on time", ("done_on_time", t)), ("Turned it in late", ("done_late", t))]
            if t["due"] < since:  # from before the tracker: or just clear it, no points
                sub += [("Done before niri-todo (no points)", ("done", t))]
        elif t["source"] in ("schoology", "todo"):  # not due yet: on time, maybe early
            early = now <= t["due"] - EARLY
            sub += [(f"Turned it in (+{PTS['done'] + EARLY_BONUS} early)" if early else f"Turned it in (+{PTS['done']})",
                     ("done", t))]
        if t["source"] == "schoology":
            sub += [("Hide (not an assignment)", ("hide", t))]
        act, t = dmenu(sub, short(t["title"], 40)) or (None, None)
    if act == "focus":
        focus(t)
    elif act == "more":
        focus(t, reopen=False)
    elif act == "rest":
        rest(t)
    elif act == "pause":  # done working on it for now; the task stays open
        with state() as s:
            s.pop("focus_next", None)
    elif act == "finish":
        finish()
    elif act == "stop":
        os.remove(FOCUS)
    elif act == "workout":
        workout_done(t)
    elif act == "open":
        open_url(t)
    elif act == "sync":
        sync()
    elif act == "done":
        mark_done(t)
    elif act == "done_on_time":
        mark_done(t, on_time=True)
    elif act == "done_late":
        mark_done(t, on_time=False)
    elif act == "hide":
        with state() as s:
            s["hidden"].append(t["id"])
    if act in ("sync", "done", "done_on_time", "done_late", "hide", "workout"):
        tick()


def selftest():
    ics = ("BEGIN:VCALENDAR\r\nBEGIN:VEVENT\r\nUID:a1\r\nSUMMARY:Essay\\, part 1\r\n  cont\r\n"
           "DTSTART:20261005T035900Z\r\nEND:VEVENT\r\nBEGIN:VEVENT\r\nUID:a2\r\nSUMMARY:Quiz\r\n"
           "DTSTART;VALUE=DATE:20261006\r\nEND:VEVENT\r\nBEGIN:VEVENT\r\nUID:a3\r\nSUMMARY:Lab\r\n"
           "DTSTART;TZID=America/New_York:20261007T080000\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n")
    e = parse_ics(ics)
    assert [x["title"] for x in e] == ["Essay, part 1 cont", "Quiz", "Lab"], e
    assert e[0]["due"] == datetime(2026, 10, 5, 3, 59, tzinfo=timezone.utc).timestamp()
    assert e[1]["due"] == datetime(2026, 10, 6, 23, 59).timestamp()
    assert e[2]["due"] == datetime(2026, 10, 7, 12, 0, tzinfo=timezone.utc).timestamp()

    now = datetime(2026, 10, 5, 12, 0).timestamp()
    t = lambda i, src, h, st="todo": {"id": i, "source": src, "due": now + h * 3600, "status": st}
    tasks = [t("late", "canvas", -5, "missing"), t("s_today", "schoology", 2), t("c_today", "canvas", 6),
             t("c_tomorrow", "canvas", 24), t("c_done", "canvas", 3, "done"), t("s_hidden", "schoology", 1)]
    s = {"scores": {}, "hidden": ["s_hidden"], "focus": ["f1"]}
    assert [x["id"] for x in todo(tasks, s, now)] == ["c_today", "s_today", "c_tomorrow", "late"]
    same_day = [t("w", "workout", 1), t("a", "anki", 11), t("s", "schoology", 1), t("c", "canvas", 6)]
    assert [x["id"] for x in todo(same_day, s, now)] == ["c", "s", "a", "w"]  # same day: Canvas, Schoology, Anki, workout
    old = [t("s_6d", "schoology", -6 * 24), t("s_8d", "schoology", -8 * 24)]
    assert [x["id"] for x in todo(old, s, now)] == ["s_6d"]  # late Schoology work stays a week
    global state, notify
    real_state, real_notify, mem = state, notify, dict(s, since=now, scores={}, hidden=[])
    state, notify = contextmanager(lambda: (yield mem)), lambda *a, **k: None
    try:
        mark_done(old[0])  # due before the first sync: cleared, no points
        assert mem["scores"] == {} and mem["hidden"] == ["s_6d"]
        mark_done(dict(old[1], title="x"), on_time=True)  # ...unless it was finished elsewhere on time
        assert mem["scores"]["s_8d"]["pts"] == 10
    finally:
        state, notify = real_state, real_notify
    mine = parse_todo("# note\n2026-10-13 20:00 Poster board\n2026-10-14 Essay\nnot a task\n")
    assert [(x["title"], x["due"]) for x in mine] == [("Poster board", datetime(2026, 10, 13, 20, 0).timestamp()),
                                                     ("Essay", datetime(2026, 10, 14, 23, 59).timestamp())], mine
    manual = [t("todo1", "todo", 30), t("gym", "workout", 11), t("gym_done", "workout", 11), t("gym_old", "workout", -1)]
    assert [x["id"] for x in todo(manual, dict(s, scores={"gym_done": {}}), now)] == ["gym", "todo1"]
    gap = [t("late_old", "canvas", -50, "missing"), t("late_new", "canvas", -5, "missing"), t("far", "canvas", 72)]
    assert [x["id"] for x in todo(gap, s, now)] == ["late_new", "late_old", "far"]  # nothing due in 2 days
    gap[2]["due"] = now + 30 * 3600
    assert [x["id"] for x in todo(gap, s, now)] == ["far", "late_new", "late_old"]

    s["scores"] = {"a": {"pts": 10, "due": 3, "on_time": True}, "b": {"pts": 3, "due": 1, "on_time": False},
                   "c": {"pts": 10, "due": 2, "on_time": True}}
    assert total(s) == 25
    a = migrate({"focus_pts": 6, "scores": {"x": {"pts": 10, "due": 1, "on_time": True}}, "days": ["2026-10-04"]})
    b = migrate({"focus_pts": 4, "hidden": ["h"], "days": ["2026-10-03"], "since": 5.0})
    a["since"] = 9.0
    b["focus"].append("2026-10-05T10:00:00 laptop")
    merge(a, b)  # sessions numbered the same on both sides count once; new ones add up
    assert (a["focus"], a["hidden"], a["days"], a["since"]) == (
        ["legacy-1", "legacy-2", "legacy-3", "2026-10-05T10:00:00 laptop"], ["h"], ["2026-10-03", "2026-10-04"], 5.0)
    assert total(a) == 18
    d = date(2026, 10, 7)
    s["days"] = ["2026-10-03", "2026-10-05", "2026-10-06"]
    assert streak(s, d) == 2  # today not done yet: yesterday's run still stands
    s["days"].append("2026-10-07")
    assert streak(s, d) == 3  # the gap on 10/04 ends it
    assert streak(s, date(2026, 10, 9)) == 0  # a whole day missed
    s["days"] = [f"2026-10-{d:02}" for d in range(1, 8)] + ["2026-10-09"]
    assert streak_info(s, date(2026, 10, 9)) == (8, 0)  # 7 days earned a freeze; it covered 10/08
    s["days"].remove("2026-10-09")
    assert streak_info(s, date(2026, 10, 10)) == (0, 0)  # two missed days, one freeze: the streak ends
    assert level_info(0) == (1, 100) and level_info(250) == (3, 50)
    assert migrate({"scores": {"m": {"pts": -5, "due": 1, "on_time": False}}})["scores"]["m"]["pts"] == 0
    mem, notify = {"scores": {}, "days": [], "focus": []}, lambda *a, **k: None
    try:
        early = {"id": "early-task", "title": "x", "due": time.time() + 3 * 86400}
        award(mem, early, "done")
        doubled = random.Random("early-task").random() < SURPRISE
        assert mem["scores"]["early-task"]["pts"] == (10 + EARLY_BONUS) * (2 if doubled else 1)
        award(mem, {"id": "m2", "title": "x", "due": time.time() - 9}, "missing")
        assert mem["scores"]["m2"]["pts"] == 0
        sent = []
        notify = lambda *a, **k: sent.append(a)
        mem["reminded"] = []
        soon = [dict(t("soon", "canvas", 20), title="x", course="y")]
        remind(mem, soon, now)
        remind(mem, [], now)  # another machine without the task must not erase its keys
        remind(mem, soon, now)
        assert len(sent) == 1, sent
        for h in (2.9, 2.6, 2.4, 0.2):  # last 3 hours: every 30 minutes, not every minute
            remind(mem, soon, soon[0]["due"] - h * 3600)
        assert len(sent) == 4, sent
    finally:
        notify = real_notify
    hits = sum(random.Random(f"t{i}").random() < SURPRISE for i in range(1000))
    assert 200 < hits < 300  # about 1 in 4
    assert (left(-90000), left(7200), left(59)) == ("1d 1h late", "2h", "0m")
    assert (left(171000), left(11100), left(2700)) == ("1d 23h", "3h 5m", "45m")
    assert (left(171000, 1), left(-90000, 1)) == ("1d", "1d late")
    assert break_until([t("x", "canvas", 100)], now) == now + 28 * 3600  # free until 3 days before it's due
    assert break_until([t("x", "canvas", 71)], now) is None  # due within 3 days: no break
    assert break_until([t("x", "canvas", -1, "missing"), t("y", "canvas", 100)], now) is None  # late work: no break
    assert [course_name(n) for n in ("202660_1_ON_ENGL101_60413", "MATH 120A Fall", "Biology")] == ["ENGL101", "MATH 120A", "Biology"]
    print("ok")


def rename_old():
    """dwm-school became dwm-todo: move its folder over once (Syncthing's folder path needs the same change)."""
    old = os.path.join(os.path.dirname(DATA), "dwm-school")
    if os.path.isdir(old) and not os.path.exists(DATA):
        os.rename(old, DATA)
        if os.path.exists(f"{DATA}/dwm-school.conf"):
            os.rename(f"{DATA}/dwm-school.conf", CONF)


def main():
    rename_old()
    cmds = {"daemon": daemon, "menu": run_menu, "selftest": selftest}
    if sys.argv[1:] == ["sync"]:
        errors = sync()
        tick()
        print(open(BAR).read().strip(), *errors, sep="\n")
    elif len(sys.argv) == 2 and sys.argv[1] in cmds:
        cmds[sys.argv[1]]()
    else:
        print(__doc__, file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
