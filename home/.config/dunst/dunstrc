# Notifications as blocks like the bar's (dark fill, 1px gray border), lined up with the windows' right
# edge under the bar. Bright title on its own line, dimmer body under it. Reload: dunstctl reload.
[global]
    font = monospace 10
    origin = top-right
    offset = (8, 36)
    # One width for all, so stacked notifications line up.
    width = 360
    height = (0, 300)
    notification_limit = 4
    padding = 10
    horizontal_padding = 14
    line_height = 2
    frame_width = 1
    frame_color = "#444444"
    gap_size = 6
    corner_radius = 0
    icon_position = off
    # The body comes out in the urgency's foreground. With no body, dunst trims the trailing newline.
    format = "<span foreground='#eeeeee'><b>%s</b></span>\n%b"
    alignment = left
    ellipsize = end
    show_age_threshold = -1
    show_indicators = no
    highlight = "#eeeeee"
    progress_bar_frame_width = 0
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#222222"
    foreground = "#888888"
    timeout = 3

[urgency_normal]
    background = "#222222"
    foreground = "#999999"
    timeout = 5

# Finished focus timers, level-ups and token warnings: stay until clicked, outlined like the focused window.
[urgency_critical]
    background = "#222222"
    foreground = "#bbbbbb"
    frame_color = "#eeeeee"
    timeout = 0
