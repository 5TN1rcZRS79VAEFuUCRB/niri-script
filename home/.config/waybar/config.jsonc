// The bar, in dwm's layout: workspaces and the focused window's title on the left; the tray, next
// assignment, system stats, volume and clock on the right. Each is a block floating a few pixels off
// the screen edges. Colors are in style.css.
{
    "position": "top",
    "margin-top": 5,
    // Reserve no space: niri keeps windows clear of the bar with struts (~/.config/niri/config.kdl),
    // so the menus (~/.local/bin/dmenu) can open over the bar instead of under it.
    "exclusive": false,
    "margin-left": 8,
    "margin-right": 8,
    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-right": ["tray", "custom/todo", "custom/stats", "custom/audio", "custom/clock"],

    // One dot per workspace, filled for the one shown. Click one to go there.
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": { "active": "●", "default": "○" }
    },
    // Right-click: the tray apps menu (Mod+Shift+T).
    "niri/window": {
        "on-click-right": "niri-tray menu"
    },
    "tray": { "spacing": 8 },
    // Next assignment, points and streak, or the focus timer (niri-status todo). niri-todo sends
    // SIGRTMIN+8 when it changes. Click: the todo menu (Mod+T).
    "custom/todo": {
        "exec": "niri-status todo",
        "interval": 1,
        "signal": 8,
        "escape": true,
        "on-click": "niri-todo menu"
    },
    // CPU/GPU, RAM and battery: niri-status prints a new line every 2 s.
    "custom/stats": {
        "exec": "niri-status",
        "escape": true
    },
    // niri-audio sends SIGRTMIN+9 after a volume or device change. Clicks as on dwm's status text:
    // left the output picker, right the input picker, middle mute, wheel the volume.
    "custom/audio": {
        "exec": "niri-audio status",
        "interval": 5,
        "signal": 9,
        "escape": true,
        "on-click": "niri-audio menu out",
        "on-click-right": "niri-audio menu in",
        "on-click-middle": "niri-audio vol mute",
        "on-scroll-up": "niri-audio vol up",
        "on-scroll-down": "niri-audio vol down"
    },
    // Not waybar's clock module: its format has no unpadded hour (%-I).
    "custom/clock": {
        "exec": "date '+%a %-I:%M %p'",
        "interval": 1
    }
}
